<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No source generator in this module, exclude generator test base -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="FsCheck" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Temporal\Pragmatic.Temporal.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Temporal.Testing\Pragmatic.Temporal.Testing.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Temporal.Json\Pragmatic.Temporal.Json.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Temporal.AspNetCore\Pragmatic.Temporal.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Temporal.EFCore\Pragmatic.Temporal.EFCore.csproj" />
  </ItemGroup>

  <!-- The fuzz harnesses, and every input they keep, replayed in the gate (#311). -->
  <ItemGroup>
    <ProjectReference Include="..\..\fuzz\Pragmatic.Temporal.Fuzz\Pragmatic.Temporal.Fuzz.csproj" />
    <None Include="..\..\fuzz\Pragmatic.Temporal.Fuzz\fuzz.json" Link="Fuzz\fuzz.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fuzz\Pragmatic.Temporal.Fuzz\Corpus\**\*" LinkBase="Fuzz\Corpus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fuzz\Pragmatic.Temporal.Fuzz\Regressions\**\*" LinkBase="Fuzz\Regressions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
