<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pragmatic.Composition</RootNamespace>
    <Description>ASP.NET Core hosting runtime for the Pragmatic.Design ecosystem. Contains IStartupStep, PragmaticApp, and middleware pipeline configuration.</Description>
    <PackageTags>composition;hosting;aspnetcore;startup;pipeline;di</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <!-- The declared-redaction runtime, so [NotLogged] is an effect and not a marker. It depends on
         Abstractions alone, which this project already carries, so the cost is one small assembly.
         Opt-in was the defect: measured 2026-08-11, nothing in the repository wired redaction, and the
         attribute's own documentation called it "enforced, and not optionally". -->
    <ProjectReference Include="..\..\..\Pragmatic.Redaction\src\Pragmatic.Redaction\Pragmatic.Redaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
  </ItemGroup>

</Project>
