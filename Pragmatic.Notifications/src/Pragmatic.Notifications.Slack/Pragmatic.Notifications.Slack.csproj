<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Slack channel for Pragmatic.Notifications. Delivers notifications to Slack incoming webhooks over plain HTTP, with no SDK.</Description>
    <PackageTags>notifications;slack;webhook;alerts;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Notifications.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Notifications\Pragmatic.Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
