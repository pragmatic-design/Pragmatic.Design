<!-- Sdk.Web for the ASP.NET Core shared framework; intended to move back to BlazorWebAssembly -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Opt out of shared testing, analyzers, etc. from Directory.Build.props -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Showcase.BlazorClient</RootNamespace>
  </PropertyGroup>

  <!-- Runtime deps: only Client helpers + Result for Result<T,E> + Abstractions for IError -->
  <ItemGroup>
    <PackageReference Include="Pragmatic.Client" />
    <PackageReference Include="Pragmatic.Result" />
    <PackageReference Include="Pragmatic.Abstractions" />
    <PackageReference Include="Pragmatic.Client.SourceGenerator" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Mode B: compile-only reference to domain assembly.
    Private=false → DLL NOT copied to output (not deployed to browser).
    The Client SG reads [PragmaticMetadata] assembly attributes at compile time
    and generates typed clients — zero file sync, always up to date.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Showcase.Booking\Showcase.Booking.csproj" Private="false" />
  </ItemGroup>

</Project>
