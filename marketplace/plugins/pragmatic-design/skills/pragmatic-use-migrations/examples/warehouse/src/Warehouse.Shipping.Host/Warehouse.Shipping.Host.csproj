<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Shipping's own process. Reached only through the gateway, and connected to the Agent that runs beside
       it on the same machine. -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <!-- The schema this host migrates to, written at build time and committed beside it. -->
    <PragmaticSchemaSnapshot>true</PragmaticSchemaSnapshot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Warehouse.Shipping\Warehouse.Shipping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pragmatic.Composition" />
    <PackageReference Include="Pragmatic.Composition.Host" />
    <PackageReference Include="Pragmatic.Endpoints.AspNetCore" />
    <PackageReference Include="Pragmatic.Endpoints.OpenApi" />
    <PackageReference Include="Pragmatic.Result.AspNetCore" />
    <PackageReference Include="Pragmatic.Persistence.EFCore" />
    <!-- A second shipment for the same picked event is a 409 naming the field, not a 500 from the index. -->
    <PackageReference Include="Pragmatic.Result.EFCore.PostgreSQL" />
    <PackageReference Include="Pragmatic.Mapping.EFCore" />
    <!-- The broker picked orders arrive on, and the outbox a dispatch leaves through. -->
    <PackageReference Include="Pragmatic.Messaging" />
    <PackageReference Include="Pragmatic.Messaging.RabbitMQ" />
    <PackageReference Include="Pragmatic.Messaging.EFCore" />
    <PackageReference Include="Pragmatic.Migrations" />
    <PackageReference Include="Pragmatic.Internationalization.AspNetCore" />
    <!-- Who calls: a token this service validates. The gateway checks it at the edge as well,
         and this host still decides what the caller may do. -->
    <PackageReference Include="Pragmatic.Identity.AspNetCore" />
    <PackageReference Include="Pragmatic.Identity.Local.Jwt" />
    <!-- The Agent beside this process: registration, heartbeat, and later the stores it backs. -->
    <PackageReference Include="Pragmatic.Agent.Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pragmatic.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Pragmatic.SourceGenerator.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- The framework's build targets come with its packages: nothing to import. -->

</Project>
