<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Pragmatic.Design client generator CLI: emits a TypeScript client (types, errors, fetch client, paging) from a compile-time PragmaticManifest.json.</Description>
    <PackageTags>pragmatic;client;typescript;codegen;manifest</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pragmatic-client</ToolCommandName>
    <RollForward>Major</RollForward>
    <!-- CLI tool: xml-doc completeness and analyzer strictness relaxed like samples -->
    <NoWarn>$(NoWarn);CS1591;CA1303;CA2007</NoWarn>
  </PropertyGroup>

</Project>
