<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Pragmatic.Client.Samples</RootNamespace>
    <!-- Generated client code emits nullable-aware types without an explicit
         #nullable directive; opt out of warnings-as-errors for this sample. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);ASP0000;CS8321;CS8601;CS8604;CS8618;CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Client\Pragmatic.Client.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Client.SourceGenerator\Pragmatic.Client.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PragmaticManifest.json" />
  </ItemGroup>

</Project>
