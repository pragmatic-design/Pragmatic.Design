<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BenchmarkDotNet requires instance methods. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Imaging.Codecs\Pragmatic.Imaging.Codecs.csproj" />
    <!-- The module, for the native library it still ships: the baseline, called through its P/Invoke
         signatures (internal, visible to this project), since the module's own PNG and JPEG paths are
         managed now. -->
    <ProjectReference Include="..\..\src\Pragmatic.Imaging\Pragmatic.Imaging.csproj" />
  </ItemGroup>

  <!-- The fixtures are encoded by an independent codec, so neither engine decodes its own encoder's choices. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tests\Pragmatic.Imaging.Codecs.Tests\Workload\SyntheticPhoto.cs" Link="Workload\SyntheticPhoto.cs" />
  </ItemGroup>

  <!-- The photograph the lossy WebP rows encode: the visual tests' reference, where its provenance is kept. -->
  <ItemGroup>
    <None Include="..\..\tests\Pragmatic.Imaging.Tests\References\Photographs\coffee.png" Link="References\Photographs\coffee.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tests\Pragmatic.Imaging.Tests\References\Gif\coffee.gif" Link="References\Gif\coffee.gif" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
