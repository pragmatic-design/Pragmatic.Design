<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- The parity tests call the native library directly, through its P/Invoke signatures, as the
         reference the managed engine is held to. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Encoded images measured against their source (shared/VisualTesting). -->
    <IncludeVisualTesting>true</IncludeVisualTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Imaging\Pragmatic.Imaging.csproj" />
    <!-- The benchmark rows themselves, so the allocations pinned here are the ones the ratchet measures
         (TheBenchmarkedOperationsAllocateWhatTheyDidTests). -->
    <ProjectReference Include="..\..\benchmarks\Pragmatic.Imaging.Benchmarks\Pragmatic.Imaging.Benchmarks.csproj" />
  </ItemGroup>

  <!-- Independent decoders: SkiaSharp reads the EXIF orientation of the fixtures, ZXing reads the QR
       codes back. Test-only, as in Pragmatic.Imaging.Codecs.Tests. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="References\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
