<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>JWT authentication handler for Pragmatic.Identity.Local. Generates and validates JWT tokens from local credentials (login/register).</Description>
    <PackageTags>identity;jwt;authentication;token;bearer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Identity.Local.Jwt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Identity.Local\Pragmatic.Identity.Local.csproj" />
    <ProjectReference Include="..\Pragmatic.Identity.AspNetCore\Pragmatic.Identity.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Composition\src\Pragmatic.Composition\Pragmatic.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
