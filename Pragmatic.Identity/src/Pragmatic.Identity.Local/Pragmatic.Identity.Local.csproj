<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Self-hosted local identity provider for Pragmatic.Design. Manages credentials, password hashing, login, registration, and password reset locally.</Description>
    <PackageTags>identity;local;authentication;password;login;register</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Identity.Local.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Identity\Pragmatic.Identity.csproj" />
    <!-- The classification attributes, so this package's own entity declares what it holds. Zero
         dependencies by design, and its csproj names Identity among the packages that have entities
         to annotate: the contracts are separated from the privacy runtime precisely so this
         reference does not run the wrong way. -->
    <ProjectReference Include="..\..\..\Pragmatic.Privacy\src\Pragmatic.Privacy.Abstractions\Pragmatic.Privacy.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
  </ItemGroup>

</Project>
