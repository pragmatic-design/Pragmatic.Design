<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generic OIDC bearer authentication for Pragmatic: validates tokens from any external OpenID Connect identity provider (via Authority/discovery) and maps its role claims into the Pragmatic authorization pipeline.</Description>
    <PackageTags>identity;oidc;openid-connect;authentication;bearer;sso</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Identity.AspNetCore\Pragmatic.Identity.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Composition\src\Pragmatic.Composition\Pragmatic.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
