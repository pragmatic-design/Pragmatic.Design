<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Comments.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      Samples for the RUNTIME surface that executes in a bare console app.
      The [HasComments] source generator IS implemented (it emits the
      {Parent}Comment entity, EF config, Add/Update/Delete actions, endpoints
      and permissions inside a real Pragmatic host). A console app does NOT run
      that host SG pipeline, so these samples exercise the hand-written runtime
      types only: HasCommentsAttribute, CommentBase<TEntityId>, CommentStatus,
      CommentVisibility, ICommentPolicy<TEntityId>, CommentRejectedError.
      A [HasComments]-annotated entity is included purely as a declaration (the
      attribute is real and compiles) to illustrate how a consumer opts in.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Comments\Pragmatic.Comments.csproj" />
  </ItemGroup>

</Project>
