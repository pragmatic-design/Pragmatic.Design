<?xml version="1.0" encoding="utf-8"?>
<!--
  Every package of this repository comes from nuget.org, on every machine. Without this file a restore
  uses whatever feeds the machine has configured, so a contributor with a company feed would resolve
  from it too, and a package name published there first would win: dependency confusion. For the same
  reason no fallback folder is read: Visual Studio installs one, and a package found there is used
  without being downloaded from the source this file names.
  examples/consumer-samples has its own nuget.config, which adds a local feed for unreleased builds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
