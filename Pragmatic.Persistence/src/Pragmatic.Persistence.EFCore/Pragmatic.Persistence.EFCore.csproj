<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Persistence.EFCore</RootNamespace>
    <Description>Entity Framework Core implementation for Pragmatic.Persistence. DbContext, Repository implementations, and EF-specific features.</Description>
    <PackageTags>pragmatic;persistence;entityframework;efcore;repository</PackageTags>
    <!-- [LoggerMessage] is Pragmatic's: the unit of work logs every save and the executor every query, and a
         generated call site writes its state to a UTF-8 provider without rendering a string first (#114). -->
    <PragmaticLogCallSites>true</PragmaticLogCallSites>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Audit\src\Pragmatic.Audit.EFCore\Pragmatic.Audit.EFCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Persistence.EFCore.Tests" />
    <InternalsVisibleTo Include="Pragmatic.Persistence.EFCore.Samples" />
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Mapping\src\Pragmatic.Mapping.EFCore\Pragmatic.Mapping.EFCore.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <!-- Classifies a provider exception into a domain error: a declared [LogicKey] or relation must not
         surface as an unhandled 500. The base package carries a provider-agnostic heuristic; installing
         Pragmatic.Result.EFCore.<Provider> sharpens it. -->
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result.EFCore\Pragmatic.Result.EFCore.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Caching\src\Pragmatic.Caching\Pragmatic.Caching.csproj" />
  </ItemGroup>

  <!-- The generator, for the log call sites. It also writes what it writes for every assembly that runs it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- EF Core -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
