<Project Sdk="Microsoft.NET.Sdk">

  <!-- The documents engine's generator, standalone until it joins Pragmatic.SourceGenerator (the persistence engines' port, the next
       part of step 6): there it reads Pragmatic's entities through the Sql feature's shape, here it runs the documents suite. -->
  <PropertyGroup>
    <RootNamespace>Pragmatic.Persistence.Documents.Generator</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Not packed: it ships inside Pragmatic.SourceGenerator once merged. -->
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!-- The shared generator code Directory.Build.props adds to every *.Generator: this one uses none of it, and it assumes the implicit
       usings this project turns off. -->
  <ItemGroup>
    <Compile Remove="$(SharedSourceGenPath)*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pragmatic's plural (a Pragmatic entity's collection), from the unified generator: one source. -->
    <Compile Include="$(PragmaticRoot)Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Features\Persistence\Sql\Transforms\PragmaticNames.cs" Link="Shared\PragmaticNames.cs" />
  </ItemGroup>

</Project>
