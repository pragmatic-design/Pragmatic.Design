<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Sql engine's generator, standalone until it joins Pragmatic.SourceGenerator (the persistence engines' port, step 4):
       there it sees Pragmatic's templates, here it runs the SQL suite. -->
  <PropertyGroup>
    <RootNamespace>Pragmatic.Persistence.Sql.Generator</RootNamespace>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Not packed: it ships inside Pragmatic.SourceGenerator once merged. -->
    <IsPackable>false</IsPackable>
    <!-- Roslyn 4.14: GetInterceptableLocation out of [Experimental] (4.12 still marked it RSEXPERIMENTAL002); the SDK 10 compiler loads older analyzers. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dialect rules (quoting, paging) are the runtime's: linked, so the SQL the generator emits and the SQL the runtime would build agree by construction. -->
    <Compile Include="..\Pragmatic.Persistence.Sql\SqlDialect.cs" Link="Shared\SqlDialect.cs" />
    <!-- The typed catalog's rendering per dialect: one source, the generator and the runtime render Sql.* the same way. -->
    <Compile Include="..\Pragmatic.Persistence.Sql\SqlCatalog.cs" Link="Shared\SqlCatalog.cs" />
    <Compile Include="..\Pragmatic.Persistence.Sql\SqlCatalog.Json.cs" Link="Shared\SqlCatalog.Json.cs" />
    <Compile Include="..\Pragmatic.Persistence.Sql\SqlCatalog.FullText.cs" Link="Shared\SqlCatalog.FullText.cs" />
    <!-- The names a grid client may never name: Pragmatic's own list, linked as Pragmatic links it into its generator and its runtime. -->
    <Compile Include="$(PragmaticRoot)shared\Contracts\SensitiveGridFieldNames.cs" Link="Shared\SensitiveGridFieldNames.cs" />
  </ItemGroup>

</Project>
