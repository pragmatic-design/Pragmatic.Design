<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pragmatic.Persistence.Sql.Pragmatic</RootNamespace>
    <Description>The Sql persistence engine as an engine of Pragmatic: its filter families, unit of work, compiled specifications and grids over Pragmatic's contracts, beside Pragmatic.Persistence.EFCore.</Description>
    <PackageTags>pragmatic;persistence;sql;unitofwork;aot</PackageTags>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Persistence.Sql\Pragmatic.Persistence.Sql.csproj" />
    <!-- What every engine's bridge shares: the filter decision, the save's phases, the scope rule registry, the grid page. -->
    <ProjectReference Include="..\Pragmatic.Persistence.Engines\Pragmatic.Persistence.Engines.csproj" />
    <!-- Pragmatic's contracts the engine serves: the filters and their toggle, the repositories, the unit of work, the scopes. -->
    <ProjectReference Include="..\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <!-- The unit of work's events: dispatched after the commit, or deferred to the commit scope's batch, as EfCoreUnitOfWork's. -->
    <ProjectReference Include="..\..\..\Pragmatic.Events\src\Pragmatic.Events\Pragmatic.Events.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <!-- A broken rule is answered with the records EF Core's unit of work answers with (Pragmatic.Result.Database). -->
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
  </ItemGroup>

</Project>
