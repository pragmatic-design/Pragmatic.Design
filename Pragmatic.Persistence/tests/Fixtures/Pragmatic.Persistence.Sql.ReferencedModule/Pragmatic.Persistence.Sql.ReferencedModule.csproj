<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pragmatic entities of another module, on the Sql engine: the suite reads them from its own assembly, as a boundary reads another
       module's entities through [ReadAccess<T>]. Their generated members (the foreign key, the private setters) reach the reader as
       metadata, not as source. A test fixture, not a package. -->
  <PropertyGroup>
    <RootNamespace>Pragmatic.Persistence.ReferencedModule</RootNamespace>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Sql.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Test code, awaited by the tests only. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\Pragmatic.Persistence.Sql.Core\Pragmatic.Persistence.Sql.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Pragmatic.Persistence.Sql\Pragmatic.Persistence.Sql.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
