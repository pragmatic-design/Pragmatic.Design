<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pragmatic.Persistence.EFCore.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Note: Test packages are auto-configured by Directory.Build.props -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Audit\src\Pragmatic.Audit.EFCore\Pragmatic.Audit.EFCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generator testing -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <!-- Runtime testing -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- EF Core for generated entity configurations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Multi-provider integration tests -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.EFCore\Pragmatic.Persistence.EFCore.csproj" />
    <!-- The provider parser, so a test can classify a real SQLSTATE the way a host does: without it
         the context falls back to the heuristic registry, which reads the message text and never sees
         a constraint name. -->
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result.EFCore.PostgreSQL\Pragmatic.Result.EFCore.PostgreSQL.csproj" />
    <!-- Direct reference to test the generator templates -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" />
    <!-- Required for metadata types -->
    <ProjectReference Include="..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <!-- Required for ICurrentUser in AuditingInterceptor tests -->
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <!-- Required for [MapFrom<T>] and [GenerateProjection] in Include Helper tests -->
    <ProjectReference Include="..\..\..\Pragmatic.Mapping\src\Pragmatic.Mapping\Pragmatic.Mapping.csproj" />
    <!-- Required for Money/CurrencyCode complex-type mapping tests (#1) -->
    <ProjectReference Include="..\..\..\Pragmatic.Internationalization\src\Pragmatic.Internationalization\Pragmatic.Internationalization.csproj" />
  </ItemGroup>

</Project>
