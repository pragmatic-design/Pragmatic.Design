<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pragmatic's declarations ([Entity], [Relation.*], [SoftDelete], [HasOwner], [HasAccessScopes]) on the Sql engine, end to end, on five
       databases: the shape Persistence declares, the chains bound on it, the filter families, the unit of work, the rows written and read
       back. -->
  <PropertyGroup>
    <!-- Starts Testcontainers (PostgreSQL, SQL Server, MySQL, Oracle; SQLite in process): scripts/check.mjs runs these one at a time. -->
    <RequiresDocker>true</RequiresDocker>
    <IsTestProject>true</IsTestProject>
    <!-- Not the folder's namespace, on purpose: under Pragmatic.Persistence.Sql, [Entity] would bind to the Sql engine's own attribute
         before Pragmatic's. -->
    <RootNamespace>PragmaticEntities.Tests</RootNamespace>
    <!-- PRAG2601: the traits here have no [Resource], so no endpoints; this suite reads and writes their children, it serves no route. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;PRAG2601</NoWarn>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Sql.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Not a generator test of Pragmatic's: the shared Roslyn testing helpers are not used here. -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- The other four databases, in Docker: the providers and containers the SQL suite uses. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Sql.Core\Pragmatic.Persistence.Sql.Core.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Sql\Pragmatic.Persistence.Sql.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <!-- [HasComments], [HasNotes] and [HasTags]: the children TraitFeature generates for an engine's parent. -->
    <ProjectReference Include="..\..\..\Pragmatic.Comments\src\Pragmatic.Comments\Pragmatic.Comments.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Notes\src\Pragmatic.Notes\Pragmatic.Notes.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Tags\src\Pragmatic.Tags\Pragmatic.Tags.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The schema the Sql engine describes for the entities migrates the databases (Pragmatic.Migrations' runner). A host's schema is
         typed for its one driver, and this suite migrates five: the generator runs again in process, once per dialect (DialectSchemas). -->
    <ProjectReference Include="..\..\..\Pragmatic.Migrations\src\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" Aliases="generator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entities' source, which DialectSchemas hands the generator. -->
    <EmbeddedResource Include="Entities.cs" LogicalName="Entities.cs" />
  </ItemGroup>

  <!-- The engine's namespaces the suite reads. Not its attributes: [Entity] here is Pragmatic's. -->
  <ItemGroup>
    <Using Include="Pragmatic.Persistence.Sql.Dialects" />
    <Using Include="Pragmatic.Persistence.Sql.Execution" />
    <Using Include="Pragmatic.Persistence.Sql.Filters" />
    <Using Include="Pragmatic.Persistence.Sql.Functions" />
    <Using Include="Pragmatic.Persistence.Sql.Planning" />
    <Using Include="Pragmatic.Persistence.Sql.Schema" />
    <Using Include="Pragmatic.Persistence.Sql.Shapes" />
    <Using Include="Pragmatic.Persistence.Sql.Writing" />
  </ItemGroup>

</Project>
