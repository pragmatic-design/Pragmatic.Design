<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pragmatic's declarations ([Entity], [Relation.*], the traits) on the documents engine, end to end, on MongoDB and on Cosmos DB: the
       shape Persistence declares, the documents' readers and writers, the chains bound on the shape, the filter families, the unit of work. -->
  <PropertyGroup>
    <!-- Starts Testcontainers (a MongoDB replica set, the Cosmos DB emulator): scripts/check.mjs runs these one at a time. -->
    <RequiresDocker>true</RequiresDocker>
    <IsTestProject>true</IsTestProject>
    <!-- Not the folder's namespace, on purpose, as the Sql bridge suite: under Pragmatic.Persistence.Documents a simple name resolves to the
         documents engine's own types (its attributes) before the usings bring in Pragmatic's. -->
    <RootNamespace>PragmaticDocuments.Tests</RootNamespace>
    <!-- PRAG2601: the traits here have no [Resource], so no endpoints; this suite reads and writes their children, it serves no route. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;PRAG2601</NoWarn>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Documents.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Not a generator test of Pragmatic's: the shared Roslyn testing helpers are not used here. -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <!-- A MongoDB replica set and the Cosmos DB emulator as generic containers. -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <!-- The engine's folders the suite reads. -->
  <ItemGroup>
    <Using Include="Pragmatic.Persistence.Documents.Filters" />
    <Using Include="Pragmatic.Persistence.Documents.Schema" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents.Core\Pragmatic.Persistence.Documents.Core.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents\Pragmatic.Persistence.Documents.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <!-- [HasComments], [HasNotes], [HasTags] and [HasAttachments]: the children TraitFeature generates for an engine's parent. The attachments'
         files go to an in-memory storage; Jobs is what makes the attachments' purge job exist. -->
    <ProjectReference Include="..\..\..\Pragmatic.Comments\src\Pragmatic.Comments\Pragmatic.Comments.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Notes\src\Pragmatic.Notes\Pragmatic.Notes.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Tags\src\Pragmatic.Tags\Pragmatic.Tags.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Attachments\src\Pragmatic.Attachments\Pragmatic.Attachments.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Storage\src\Pragmatic.Storage.InMemory\Pragmatic.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Jobs\src\Pragmatic.Jobs\Pragmatic.Jobs.csproj" />
    <!-- [DataSubject], [PersonalData]: the privacy adapters (access and erasure) generated for the entities the engine persists. -->
    <ProjectReference Include="..\..\..\Pragmatic.Privacy\src\Pragmatic.Privacy\Pragmatic.Privacy.csproj" />
    <!-- LocalIdentity, owned by a [PragmaticUser]: a nested document, and the generated LocalIdentityStore on the engine. -->
    <ProjectReference Include="..\..\..\Pragmatic.Identity\src\Pragmatic.Identity.Local\Pragmatic.Identity.Local.csproj" />
    <!-- ProtectedValue: a document field, its bytes as Base64 text (ProtectedValueTests). -->
    <ProjectReference Include="..\..\..\Pragmatic.Cryptography\src\Pragmatic.Cryptography\Pragmatic.Cryptography.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The callers the Sql engine's bridge suite reads as (TestUser, TestScopes): the same callers on both engines. -->
    <Compile Include="..\Pragmatic.Persistence.Sql.Tests\Callers.cs" Link="Shared\Callers.cs" />
    <!-- The one MongoDB readiness wait: a server that exits fails the start at once, with its log. -->
    <Compile Include="..\Pragmatic.Persistence.Documents.Core.Tests\LoggedUnlessExited.cs" Link="Shared\LoggedUnlessExited.cs" />
  </ItemGroup>

</Project>
