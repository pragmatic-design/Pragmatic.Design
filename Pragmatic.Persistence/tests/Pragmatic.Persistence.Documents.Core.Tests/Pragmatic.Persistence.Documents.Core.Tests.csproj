<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Starts Testcontainers (MongoDB, a MongoDB replica set, the Cosmos DB emulator): scripts/check.mjs runs these one at a time
         (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pragmatic.Persistence.Documents.Core.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;xUnit1004</NoWarn>
    <!-- The document chains' interceptors live in this namespace; the generated code is kept under obj/ to be read. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Documents.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Not a generator test of Pragmatic's: the shared Roslyn testing helpers are not used here. -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <!-- MongoDB and the Cosmos DB emulator as generic containers. -->
    <PackageReference Include="Testcontainers" />
  </ItemGroup>

  <!-- The engine's folders the suite reads. -->
  <ItemGroup>
    <Using Include="Pragmatic.Persistence.Documents.Conversion" />
    <Using Include="Pragmatic.Persistence.Documents.Execution" />
    <Using Include="Pragmatic.Persistence.Documents.Filters" />
    <Using Include="Pragmatic.Persistence.Documents.Planning" />
    <Using Include="Pragmatic.Persistence.Documents.Schema" />
    <Using Include="Pragmatic.Persistence.Documents.Writing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents.Core\Pragmatic.Persistence.Documents.Core.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents.Mongo\Pragmatic.Persistence.Documents.Mongo.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents.Cosmos\Pragmatic.Persistence.Documents.Cosmos.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Fixtures\Pragmatic.Persistence.Documents.Workload\Pragmatic.Persistence.Documents.Workload.csproj" />
  </ItemGroup>

</Project>
