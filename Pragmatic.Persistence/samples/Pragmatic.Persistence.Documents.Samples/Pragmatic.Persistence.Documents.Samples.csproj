<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Not the folder's namespace, on purpose, as the documents bridge suite: under Pragmatic.Persistence.Documents, `Pragmatic` names the
         bridge's namespace (Pragmatic.Persistence.Documents.Pragmatic) before the usings bring in Pragmatic's own. -->
    <RootNamespace>PragmaticDocumentSamples</RootNamespace>
    <!-- The samples run as they are (dotnet run) and publish Native AOT (dotnet publish -c Release -r win-x64
         -p:PragmaticAotSmokeRestore=true), as the Sql engine's samples: PublishAot only while publishing (see there why). -->
    <PublishAot Condition="'$(_IsPublishing)' == 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Documents.Generated</InterceptorsNamespaces>
    <!-- The generated plans, readers and writers land in obj/.../generated: every chain's query is there to read. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents\Pragmatic.Persistence.Documents.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence.Documents.Pragmatic\Pragmatic.Persistence.Documents.Pragmatic.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <ProjectReference Include="..\..\tests\Fixtures\Pragmatic.Persistence.Documents.Workload\Pragmatic.Persistence.Documents.Workload.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
