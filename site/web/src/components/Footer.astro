---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-outline-variant">
  <div class="max-w-7xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-2.5">
        <img src="/logo.png" alt="Pragmatic Design" class="w-5 h-5 rounded" />
        <span class="text-sm text-text-muted">
          &copy; {currentYear} Alessandro Saiani. All rights reserved.
        </span>
      </div>

      <div class="flex items-center gap-6 text-sm text-text-muted">
        <a href="https://docs.pragmaticdesign.net" class="hover:text-primary transition-colors">
          Docs
        </a>
        <a href="https://github.com/pragmatic-design/Pragmatic.Design" class="hover:text-primary transition-colors">
          GitHub
        </a>
        <a href="https://www.nuget.org/profiles/Pragmatic.Design" class="hover:text-primary transition-colors">
          NuGet
        </a>
      </div>
    </div>
  </div>
</footer>
