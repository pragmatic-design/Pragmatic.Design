<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Zero-dependency email library for Pragmatic.Design. SMTP with connection pooling, DKIM signing, attachments, middleware pipeline, and testing transports.</Description>
    <PackageTags>email;smtp;dkim;attachments;pooling;mime;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Email.Tests" />
    <InternalsVisibleTo Include="Pragmatic.Email.Testing" />
    <InternalsVisibleTo Include="Pragmatic.Notifications" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

</Project>
