<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Client library for connecting .NET apps to the Pragmatic Agent daemon. Provides AgentControlPlane, AgentConfigurationStore, AgentFeatureFlagStore, and socket-based IPC.</Description>
    <PackageTags>agent;client;ipc;controlplane;configuration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The stores are internal; their contract tests are not. Same arrangement as Pragmatic.Agent. -->
    <InternalsVisibleTo Include="Pragmatic.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Agent.Protocol\Pragmatic.Agent.Protocol.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <!-- The configuration bridge: UseAgent() puts the Agent-backed store into the host's IConfiguration. -->
    <ProjectReference Include="..\..\..\Pragmatic.Configuration\src\Pragmatic.Configuration\Pragmatic.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
