    <PackageTags>agent;discovery;topology;kv</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Agent.Client\Pragmatic.Agent.Client.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Discovery\src\Pragmatic.Discovery\Pragmatic.Discovery.csproj" />
  </ItemGroup>

</Project>
