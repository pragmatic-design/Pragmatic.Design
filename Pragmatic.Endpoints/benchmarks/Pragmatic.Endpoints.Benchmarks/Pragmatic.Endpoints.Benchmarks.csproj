<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Suppress CA1822 for BenchmarkDotNet (requires instance methods) -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <!-- The generated response writers (#51): an endpoint per workload is what makes the generator write one,
         and ASP.NET's JsonOptions are the options a host starts from. -->
    <ProjectReference Include="..\..\src\Pragmatic.Endpoints\Pragmatic.Endpoints.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Endpoints.AspNetCore\Pragmatic.Endpoints.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Benchmark comparison only: a tuned, non-generated writer to measure against (#51). -->
    <PackageReference Include="CAPCOM.REDox" />
  </ItemGroup>

</Project>
