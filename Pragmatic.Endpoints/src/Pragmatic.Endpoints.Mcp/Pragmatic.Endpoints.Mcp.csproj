<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>MCP (Model Context Protocol) exposure for Pragmatic.Design endpoints: [McpTool] endpoints become MCP tools with input schemas derived from the compile-time manifest — zero reflection. Self-HTTP execution reuses the full endpoint pipeline (authz, validation, tenancy).</Description>
    <PackageTags>mcp;model-context-protocol;pragmatic;tools;ai</PackageTags>
    <!-- The MCP SDK's HTTP transport is not fully trim/AOT annotated yet; isolate the limit here. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Endpoints.OpenApi\Pragmatic.Endpoints.OpenApi.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Composition\src\Pragmatic.Composition.Host\Pragmatic.Composition.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
