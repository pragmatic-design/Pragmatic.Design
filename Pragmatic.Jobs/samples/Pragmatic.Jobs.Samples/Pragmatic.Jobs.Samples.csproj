<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>
    <NoWarn>$(NoWarn);ASP0000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Jobs\Pragmatic.Jobs.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Jobs.EFCore\Pragmatic.Jobs.EFCore.csproj" />
    <!-- Bridge: lets MessageSchedulerBridgeSample reference IMessageScheduler /
         EnableScheduledMessages() / JobsMessageScheduler so the bridge API is
         demonstrated and compiled against real types. -->
    <ProjectReference Include="..\..\..\Pragmatic.Messaging\src\Pragmatic.Messaging.Jobs\Pragmatic.Messaging.Jobs.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Messaging\src\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite gives the EF Core / distributed-locking samples a real relational
         store (with ExecuteUpdateAsync lease atomicity) without a Docker dependency. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
