<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source-generated PATCH DTOs with tri-state Optional&lt;T&gt; for partial updates. Compile-time, zero reflection.</Description>
    <PackageTags>patch;partial-update;source-generator;optional;json-patch</PackageTags>
    <IsGeneratorRuntime>true</IsGeneratorRuntime>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Patch.Tests" />
  </ItemGroup>

  <!-- Include source generator as analyzer -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>


</Project>
