<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for Pragmatic.Result. Provides ProblemDetails serialization and HTTP result handling.</Description>
    <PackageTags>result;problem-details;rfc7807;aspnetcore;http;minimal-api</PackageTags>
    <!-- net11.0 carries the OpenAPI transformers built against Microsoft.OpenApi 3, which ASP.NET Core 11 brings;
         net10.0 keeps Microsoft.OpenApi 2. The public API is the same on both (#832, #836). The two targets come
         from Directory.Build.props (#931). -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Result\Pragmatic.Result.csproj" />
  </ItemGroup>

</Project>
