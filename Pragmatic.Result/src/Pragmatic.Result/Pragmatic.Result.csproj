<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>High-performance Result pattern for railway-oriented programming. Zero allocation wrapper, type-safe errors, LINQ operations.</Description>
    <PackageTags>result;result-pattern;error-handling;functional;railway-oriented;zero-allocation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Internationalization\src\Pragmatic.Internationalization\Pragmatic.Internationalization.csproj" />
    <!-- The unified generator, so this assembly's own errors register their discriminator and schema
         like every other module's do. Without it the framework errors were the only ones the OpenAPI
         enricher still had to discover reflectively. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Pragmatic.Result.SourceGenerator\Pragmatic.Result.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The companion analyzer travels in this package. Published on its own it is referenced by
       nobody — not the scaffolding template, not a single consumer — so its diagnostics have never
       fired outside our own build. -->
  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Result.Analyzers\Pragmatic.Result.Analyzers.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" PackAsCompanionAnalyzer="true" />
  </ItemGroup>

</Project>
