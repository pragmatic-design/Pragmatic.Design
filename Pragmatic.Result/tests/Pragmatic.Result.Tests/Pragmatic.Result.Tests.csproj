<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CA2007 conflicts with xUnit1030 in test projects - disable for tests -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="FsCheck" />
  </ItemGroup>

  <!-- The fuzz harnesses, and every input they keep, replayed in the gate (#312). -->
  <ItemGroup>
    <ProjectReference Include="..\..\fuzz\Pragmatic.Result.Fuzz\Pragmatic.Result.Fuzz.csproj" />
    <None Include="..\..\fuzz\Pragmatic.Result.Fuzz\fuzz.json" Link="Fuzz\fuzz.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fuzz\Pragmatic.Result.Fuzz\Corpus\**\*" LinkBase="Fuzz\Corpus" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\fuzz\Pragmatic.Result.Fuzz\Regressions\**\*" LinkBase="Fuzz\Regressions" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Result.SourceGenerator\Pragmatic.Result.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <!-- Unified generator: as an Analyzer so the multi-error round-trip tests exercise the CONVERTER IT
         GENERATES, not a reflective factory. Also still driven manually via GeneratorTestHelper for the
         WriteExtensions tests — the two uses do not conflict. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
