<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pragmatic.Authorization.Management.EFCore</RootNamespace>
    <Description>Pragmatic.Authorization.Management on EF Core: the package's roles, permissions and assignments read and written through the DbContext of the boundary that imports it.</Description>
    <PackageTags>authorization;rbac;permissions;roles;management;efcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contract (IAuthorizationManagementStore) and the entities, whose tables the importing boundary's context maps. -->
    <ProjectReference Include="..\Pragmatic.Authorization.Management\Pragmatic.Authorization.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
