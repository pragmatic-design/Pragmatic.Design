<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Override IsTest detection from Directory.Build.props -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>

    <!-- Emit generated files so we can inspect them -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\GeneratedFiles</CompilerGeneratedFilesOutputPath>

    <!-- Suppress missing XML comment warnings and CA2007 in test project -->
    <NoWarn>$(NoWarn);CS1591;CA2007;CA1001</NoWarn>

    <!-- Prevent test SDK from generating its own entry point (we have Program.cs) -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- ASP.NET Core integration testing -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The runtime OpenAPI document, for what EnableOpenApi = false leaves out of it. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Pinned as in Pragmatic.Endpoints.OpenApi: the transitive 2.0.0 carries GHSA-v5pm-xwqc-g5wc. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

  <!-- Runtime project references -->
  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\Pragmatic.Endpoints\src\Pragmatic.Endpoints\Pragmatic.Endpoints.csproj" />
    <ProjectReference Include="..\Pragmatic.Endpoints\src\Pragmatic.Endpoints.AspNetCore\Pragmatic.Endpoints.AspNetCore.csproj" />
    <!-- The manifest enrichment of the runtime document, in a host without Composition. -->
    <ProjectReference Include="..\Pragmatic.Endpoints\src\Pragmatic.Endpoints.OpenApi\Pragmatic.Endpoints.OpenApi.csproj" />
    <ProjectReference Include="..\Pragmatic.Validation\src\Pragmatic.Validation\Pragmatic.Validation.csproj" />
    <ProjectReference Include="..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
  </ItemGroup>

  <!-- Unified source generator -->
  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
