    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Storage.Azure</RootNamespace>
    <Description>Azure Blob Storage file storage provider for Pragmatic.Design.</Description>
    <PackageTags>pragmatic;storage;azure;blob;cloud</PackageTags>
