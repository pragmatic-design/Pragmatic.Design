  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Storage\Pragmatic.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" />
  </ItemGroup>

</Project>
