    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Storage.GoogleCloud</RootNamespace>
    <Description>Google Cloud Storage file storage provider for Pragmatic.Design.</Description>
    <PackageTags>pragmatic;storage;google;gcs;gcp;cloud</PackageTags>
