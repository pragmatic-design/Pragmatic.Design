<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pragmatic.VisualTesting.Tests</RootNamespace>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <!-- The harness under test, the PDF rasteriser included. -->
    <IncludeVisualTestingPdf>true</IncludeVisualTestingPdf>
  </PropertyGroup>

  <!-- An independent PNG decoder for the fixtures, so the metrics are not checked through a codec of ours. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <None Include="References\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
