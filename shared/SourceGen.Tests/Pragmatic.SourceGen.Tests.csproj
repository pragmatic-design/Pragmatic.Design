<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pragmatic.SourceGen.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Note: Test packages are auto-configured by Directory.Build.props -->

  <ItemGroup>
    <!-- Roslyn for symbol analysis testing -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
  </ItemGroup>

  <!-- Include shared SourceGen files to test (excluding Testing, which is auto-included via Directory.Build.props) -->
  <ItemGroup>
    <Compile Include="..\SourceGen\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
