<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Claim check pattern for Pragmatic.Messaging — payloads above a threshold move to Pragmatic.Storage (local/Azure/S3) and messages carry only the reference.</Description>
    <PackageTags>messaging;claim-check;large-payloads;storage</PackageTags>
  </PropertyGroup>

  <!-- Expose internals to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Storage\src\Pragmatic.Storage\Pragmatic.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
