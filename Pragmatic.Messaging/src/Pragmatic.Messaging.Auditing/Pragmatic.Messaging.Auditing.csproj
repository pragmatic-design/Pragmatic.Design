<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Message auditing for Pragmatic.Messaging: records every handled message on the framework's Pragmatic.Audit trail. Who sent what, when, with what result -- by reference, never by payload.</Description>
    <PackageTags>messaging;auditing;audit-trail;observability;compliance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Audit\src\Pragmatic.Audit\Pragmatic.Audit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
