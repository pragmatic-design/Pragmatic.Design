<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Bridge between Pragmatic.Messaging and Pragmatic.Jobs: schedule messages for future delivery via IMessageScheduler.</Description>
    <PackageTags>messaging;jobs;scheduler;delayed;bridge</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Jobs\src\Pragmatic.Jobs\Pragmatic.Jobs.csproj" />
    <!-- This package ships a [Job] of its own — PublishMessageJob — so it generates the registry that
         knows it, like any assembly that declares one. Without it the runner refused the job it had
         just been handed, and the message it carried was already acknowledged. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
