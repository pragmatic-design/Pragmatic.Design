<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Apache Kafka message transport for Pragmatic.Messaging. Consumer groups, partition assignment, exactly-once semantics.</Description>
    <PackageTags>messaging;kafka;transport;streaming;consumer-groups;distributed</PackageTags>
    <!-- [LoggerMessage] is Pragmatic's: the transport logs per delivery, and a generated call site writes
         its state to a UTF-8 provider without rendering a string first (#114). -->
    <PragmaticLogCallSites>true</PragmaticLogCallSites>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
  </ItemGroup>

  <!-- The generator, for the log call sites. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
  </ItemGroup>

</Project>
