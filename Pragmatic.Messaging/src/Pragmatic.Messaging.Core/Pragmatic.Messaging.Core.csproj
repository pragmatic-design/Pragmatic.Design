<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pragmatic.Messaging</RootNamespace>
    <Description>Core messaging abstractions: IMessageBus, handlers, middleware, routing, serialization. Zero dependency on Events, EFCore, or Actions.</Description>
    <PackageTags>messaging;core;handler;pipeline;middleware;routing</PackageTags>
  </PropertyGroup>

  <!-- Expose internals to bridge and sibling packages -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Messaging" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.Tests" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.Channels" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.RabbitMQ" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.Auditing" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.Kafka" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.AzureServiceBus" />
    <InternalsVisibleTo Include="Pragmatic.Messaging.Sql" />
  </ItemGroup>

  <!-- Core dependencies only — zero Events/Actions/Persistence/Mapping/EFCore -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Resilience\src\Pragmatic.Resilience\Pragmatic.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
