<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pragmatic.Messaging.EFCore</RootNamespace>
    <Description>EF Core-backed stores for Pragmatic.Messaging: outbox source, idempotency, audit trail persistence.</Description>
    <PackageTags>messaging;efcore;outbox;idempotency;auditing;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
    <ProjectReference Include="..\Pragmatic.Messaging.Auditing\Pragmatic.Messaging.Auditing.csproj" />
    <!-- The outbox interceptor, delivery pump and entity config live in the bridge assembly; the
         boundary-level [EnableOutbox] wiring (MessagingOutboxExtensions) consolidates them here so
         the SG-generated host code depends only on Pragmatic.Messaging.EFCore (the HasMessagingEFCore
         gate guarantees this reference). Acyclic: the bridge does not reference this assembly. -->
    <ProjectReference Include="..\Pragmatic.Messaging\Pragmatic.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
