<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================
       Conformance.Split — one assembly, TWO boundaries.
       It exists for the [Owns<T>] cell, which is needed only here: with a single boundary there
       is nothing to choose, and every other topology in the repository has one per assembly.
       It is also the only one that demonstrates the host registering every boundary of the
       module instead of looking one up by name.
       ======================================== -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
