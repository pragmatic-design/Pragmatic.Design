<Project Sdk="Microsoft.NET.Sdk">

  <!-- What Verify publishes, and the only thing Intake is allowed to reference of it. The mirror of
       Casework.Intake.Contracts, and a second project rather than one shared "Casework.Contracts":
       a contract belongs to the service that publishes it, and one assembly for both would be a place
       where either service could quietly depend on the other's shape. The two never meet in a project
       reference — Intake references this, Verify references Intake's, and neither references the other's
       module (asserted by TheContractIsTheOnlyThingShared). -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <!-- IIntegrationEvent and IDomainEvent are declared here. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <!-- And the DomainEvent base record, for the EventId the consumer keys its write off. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Events\src\Pragmatic.Events\Pragmatic.Events.csproj" />
    <!-- [CorrelationKey], for the same reason — see the same line in Casework.Intake.Contracts. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Messaging\src\Pragmatic.Messaging.Core\Pragmatic.Messaging.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
