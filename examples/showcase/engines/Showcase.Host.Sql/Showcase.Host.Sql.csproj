<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Showcase.Host on the Sql engine: the same source files as src/Showcase.Host, linked, over the Sql engine's module projects, with the
       engines' stores in place of EF Core's and PostgreSQL through Npgsql. What only EF Core serves is left out by the list below, each with
       its reason. -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <RootNamespace>Showcase.Host</RootNamespace>
    <!-- The generator names a host's own extensions (SeedFromJson) after its assembly: the linked Program.cs calls them in Showcase.Host. -->
    <AssemblyName>Showcase.Host</AssemblyName>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Sql.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- As in src/Showcase.Host: the OpenAPI XML comment generator parses every <example> tag as JSON. -->
  <Target Name="DisableOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\..\src\Showcase.Host\**\*.cs" Exclude="..\..\src\Showcase.Host\obj\**;..\..\src\Showcase.Host\bin\**" LinkBase="Host" />
    <AdditionalFiles Include="..\..\src\Showcase.Host\roles.pragmatic.json" Link="roles.pragmatic.json" />
    <Content Include="..\..\src\Showcase.Host\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Showcase.Host\localization\*.json" LinkBase="localization" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The host's wiring on EF Core (#534): the boundaries' DbContexts, the notification store's own context, and the per-user culture, which
       reads through the user resolver of Pragmatic.Identity.Persistence (#549). ShowcaseEngine.Sql.cs is this host's. -->
  <ItemGroup>
    <Compile Remove="..\..\src\Showcase.Host\Engine\ShowcaseEngine.EfCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Showcase.Catalog.Sql\Showcase.Catalog.Sql.csproj" />
    <ProjectReference Include="..\Showcase.Booking.Sql\Showcase.Booking.Sql.csproj" />
    <ProjectReference Include="..\Showcase.Accounts.Sql\Showcase.Accounts.Sql.csproj" />
    <ProjectReference Include="..\Showcase.Billing.Sql\Showcase.Billing.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.Audit\src\Pragmatic.Audit.Engines\Pragmatic.Audit.Engines.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Audit\src\Pragmatic.Audit.Management\Pragmatic.Audit.Management.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Composition\src\Pragmatic.Composition\Pragmatic.Composition.csproj" />
