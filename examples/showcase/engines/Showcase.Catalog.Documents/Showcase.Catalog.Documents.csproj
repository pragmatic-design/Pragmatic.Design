<Project Sdk="Microsoft.NET.Sdk">

  <!-- Showcase.Catalog on the documents engine: the same source files as src/Showcase.Catalog, linked, with the documents engine's bridge in
       place of EF Core's. What only EF Core serves is left out by the list below, each with its reason. -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <RootNamespace>Showcase.Catalog</RootNamespace>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Documents.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Showcase.Catalog\**\*.cs" Exclude="..\..\src\Showcase.Catalog\obj\**;..\..\src\Showcase.Catalog\bin\**" LinkBase="Catalog" />
    <AdditionalFiles Include="..\..\src\Showcase.Catalog\translations\*.json" LinkBase="translations" />
  </ItemGroup>

  <!-- EF Core only, by the owner's list (#363): the boundary's DbContext, and the two grids that take an IQueryable. -->
  <ItemGroup>
    <Compile Remove="..\..\src\Showcase.Catalog\Amenities\Actions\CountAmenitiesAction.cs" />
    <Compile Remove="..\..\src\Showcase.Catalog\Properties\Endpoints\DevExpressSearchPropertiesEndpoint.cs" />
    <Compile Remove="..\..\src\Showcase.Catalog\Properties\Endpoints\GridSearchPropertiesEndpoint.cs" />
  </ItemGroup>

  <!-- Refused by the documents engine by design (#479): a document keeps a relation as its key, so there is no navigation to load or write
       (PRAG3112). Deleting and restoring a property cascade into its room types; updating a room type loads its property. -->
  <ItemGroup>
    <Compile Remove="..\..\src\Showcase.Catalog\Properties\Mutations\DeletePropertyMutation.cs" />
    <Compile Remove="..\..\src\Showcase.Catalog\Properties\Mutations\RestorePropertyMutation.cs" />
    <Compile Remove="..\..\src\Showcase.Catalog\RoomTypes\Mutations\UpdateRoomTypeMutation.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence.Documents.Core\Pragmatic.Persistence.Documents.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence.Documents\Pragmatic.Persistence.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Specification\src\Pragmatic.Specification\Pragmatic.Specification.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Mapping\src\Pragmatic.Mapping\Pragmatic.Mapping.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Validation\src\Pragmatic.Validation\Pragmatic.Validation.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Caching\src\Pragmatic.Caching\Pragmatic.Caching.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Temporal\src\Pragmatic.Temporal\Pragmatic.Temporal.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Internationalization\src\Pragmatic.Internationalization\Pragmatic.Internationalization.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Events\src\Pragmatic.Events\Pragmatic.Events.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Endpoints\src\Pragmatic.Endpoints\Pragmatic.Endpoints.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Endpoints\src\Pragmatic.Endpoints.AspNetCore\Pragmatic.Endpoints.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Storage\src\Pragmatic.Storage\Pragmatic.Storage.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Patch\src\Pragmatic.Patch\Pragmatic.Patch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator.Analyzers\Pragmatic.SourceGenerator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
