<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================
       Showcase.Host.Sql.Tests — starts the Showcase host on the Sql engine against PostgreSQL (#534).

       ⚠️ A project of its own, as Showcase.Billing.Host.Tests: a host's entry point is a `Program` in the GLOBAL namespace, and the engine
       hosts share the assembly name Showcase.Host, so one test project cannot reference two of them.
       ======================================== -->

  <PropertyGroup>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <!-- CA2007: not meaningful in test projects (no SynchronizationContext) -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engines\Showcase.Host.Sql\Showcase.Host.Sql.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Testing\src\Pragmatic.Testing\Pragmatic.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
