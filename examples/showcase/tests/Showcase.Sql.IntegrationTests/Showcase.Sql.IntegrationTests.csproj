<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========================================
       Showcase.Sql.IntegrationTests — the Showcase's integration suite on the Showcase host on the Sql engine (#535): the same test files
       as Showcase.IntegrationTests, linked, against Showcase.Host.Sql over PostgreSQL.

       Every file left out is on scripts/engine-suites.mjs's list with the exclusion it follows from, and the gate fails on one that is not
       ("the Showcase suite on each engine"). A project of its own per engine, as Showcase.Host.Sql.Tests: the engine hosts share the assembly
       name Showcase.Host and a global Program, so one test project cannot reference two of them.
       ======================================== -->

  <PropertyGroup>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <!-- CA2007: not meaningful in test projects (no SynchronizationContext) -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <RootNamespace>Showcase.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Showcase.IntegrationTests\**\*.cs" Exclude="..\Showcase.IntegrationTests\obj\**;..\Showcase.IntegrationTests\bin\**" LinkBase="Suite" />
    <Compile Include="..\..\..\shared\Testing\*.cs" LinkBase="Shared\Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaced, not left out: the engine host's appsettings.json and localization/ are linked into its output, so the content root is
         the output, and the connection strings go through UseSetting (ShowcaseWebFactory.cs beside this project). -->
    <Compile Remove="..\Showcase.IntegrationTests\Infrastructure\ShowcaseWebFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaced, not left out: a boundary's saves counted through a save phase keyed by the boundary (CommitCounter.cs beside this
         project), since EF Core's copy counts its DbContext's SavingChanges. -->
    <Compile Remove="..\Showcase.IntegrationTests\Infrastructure\CommitCounter.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core only (#363): the grids and the amenity count read through an IQueryable, and the module projects leave them out on the
         engines. -->
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\BoundaryKeyedServicesTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\Endpoints\GridSearchTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\Endpoints\TheGridInItsOwnFormatTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test code bound to EF Core (owner decision, 2026-11-06): the test itself reads or prepares rows through a DbContext, EF Core's
         nested repositories, or references a project built over the EF Core modules (the Blazor client, its routes). The
         feature it exercises runs on the engine; the test's own code does not. -->
    <Compile Remove="..\Showcase.IntegrationTests\Endpoints\AnUploadWhoseCommitIsNotAcknowledgedTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real gap (#904): the durable job store exists on EF Core only. These exercise EfCoreJobStore itself, through a DbContext of
         the test's own; the engines have no store for them to run against. -->
    <Compile Remove="..\Showcase.IntegrationTests\Jobs\JobExecutionEndToEndTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\Jobs\JobLeaseIntegrationTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\Jobs\JobsDbContext.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\Jobs\WhatRunsAfterTheJobFinishesTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engines\Showcase.Host.Sql\Showcase.Host.Sql.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Migrations\src\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Email\src\Pragmatic.Email.Testing\Pragmatic.Email.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Notifications\src\Pragmatic.Notifications.Testing\Pragmatic.Notifications.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Testing\src\Pragmatic.Testing\Pragmatic.Testing.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Testing\src\Pragmatic.Testing.SourceGenerator\Pragmatic.Testing.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The generated typed client, exercised against this engine's host by GeneratedClientTests (#874). -->
    <ProjectReference Include="..\..\src\Showcase.BlazorClient\Showcase.BlazorClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.ServiceBus" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real gap (#881): the engines have no [Lookup] cache. These two exercise it whole, filled at startup and reloaded by a write. -->
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\ALookupWriteReloadsTheCacheTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\LookupCacheTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core's own mechanism: a temporal relation's query extensions compose onto an IQueryable, which the engines do not read
         through. Their repository form (TemporalRepositoryFormTests, #899) runs here. -->
    <Compile Remove="..\Showcase.IntegrationTests\EntityPersistence\TemporalQueryExtensionsTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core's own mechanisms, which the engines do not have by construction: the set [ReadAccess] adds to the reading boundary's
         context (the reader reads through the owner's repository there), and the queryable extension of a declared specification (they
         read through their own query model, not an IQueryable), and a DTO's projection translated to SQL through EF Core's value
         converter (the same); whether two boundaries' DbContexts share a DbConnection; and the column lengths of the RBAC package's
         entities in EF Core's model (the engines' rows are the package's own types, which declare them). -->
    <Compile Remove="..\Showcase.IntegrationTests\Authorization\ThePackagesColumnLengthsTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\DeclaredSpecificationQueryableTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\LocalizedFieldProjectionTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\CrossCutting\ReadAccessSetTests.cs" />
    <Compile Remove="..\Showcase.IntegrationTests\DomainActions\BoundaryDbConnectionTests.cs" />
  </ItemGroup>


  <ItemGroup>
    <!-- Names a type the generator puts in the assembly's namespace (Showcase.Booking.ApiRoutes): an engine copy is another assembly, so it does not compile here. Not a gap. -->
    <Compile Remove="..\Showcase.IntegrationTests\Endpoints\ApiRoutesConstantsTests.cs" />
  </ItemGroup>

</Project>
