<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ========================================
       Showcase.Host — ASP.NET Core host
       Features: Composition, Endpoints, Identity, MultiTenancy, I18n.AspNetCore, Temporal.AspNetCore
       ======================================== -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <!-- Schema snapshot: regenerate schema/<db>.schema.json after build via the
       Pragmatic.Migrations target. Monorepo wiring uses the CLI built from source
       (Pragmatic.Migrations.LocalCli.targets, imported at the end). -->
  <PropertyGroup>
    <PragmaticSchemaSnapshot>true</PragmaticSchemaSnapshot>
  </PropertyGroup>

  <!-- Disable OpenAPI XML comment SG: causes 1000+ first-chance JsonReaderException in debug
       because it tries JsonNode.Parse() on every XML <example> tag, including non-JSON text.
       OpenAPI document generation works fine without it — just no XML comment enrichment. -->
  <Target Name="DisableOpenApiXmlCommentGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

  <!-- Domain modules -->
  <ItemGroup>
    <ProjectReference Include="..\Showcase.Catalog\Showcase.Catalog.csproj" />
