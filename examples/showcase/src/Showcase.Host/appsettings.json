{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "Host=localhost;Port=5433;Database=showcase_app;Username=pragmatic;Password=Pragmatic@2026!",
    "Financial": "Host=localhost;Port=5433;Database=showcase_financial;Username=pragmatic;Password=Pragmatic@2026!"
  },
  "I18N": {
    "DefaultUICulture": "en-US",
    "SupportedCultures": [ "en-US", "it-IT" ]
  },
  "Resilience": {
    "Policies": {
      "payment-provider": {
        "Timeout": {
          "Timeout": "00:00:10"
        },
        "Retry": {
          "MaxRetries": 3,
          "BaseDelay": "00:00:00.500",
          "BackoffType": 2,
          "UseJitter": true
        },
        "CircuitBreaker": {
          "FailureThreshold": 5,
          "BreakDuration": "00:00:30"
        }
      }
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "SenderAddress": "noreply@showcase.pragmatic.design",
    "SenderName": "Showcase Hotel",
    "_comment": "Port 1025 = Mailpit/smtp4dev dev server. Run: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit"
  },
  "Showcase": {
    "AppName": "Pragmatic Showcase",
    "MaxGuestsPerProperty": 100,
    "CancellationWindowHours": 24,
    "SeedDemoData": true
  },
  "Telemetry": {
    "Enabled": true,
    "Tracing": true,
    "Metrics": true,
    "Logging": true,
    "UseOtlpExporter": false,
    "ServiceName": "pragmatic-showcase",
    "SamplingRatio": 1.0
  }
}
