<Project>
  <!-- A Directory.Build.props here stops MSBuild's upward search, so the root one is imported by hand. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Read the implicit usings of the Pragmatic projects referenced, as an application gets them from the packages. -->
    <PragmaticInRepoImplicitUsings>true</PragmaticInRepoImplicitUsings>
    <!-- [LoggerMessage] is generated by Pragmatic, as it is for an application that installs the package. -->
    <PragmaticLogCallSites>true</PragmaticLogCallSites>

    <!-- The example is read as much as it is run: the generated code is written to obj/ so the README
         can point at it and count it. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
</Project>
