<Project>
  <!-- A Directory.Build.props here stops MSBuild's upward search, so the root one is imported by hand. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- The application on both releases Pragmatic supports (#923): its suite runs once per target, so a .NET 11 regression an application
       would see is caught here. The root props set the single TargetFramework, which would make the SDK build one target only. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
  </PropertyGroup>

  <!-- On net11.0 the language an application created on .NET 11 gets by default, so the generator emits for a C# 15 consumer there; the
       repository pins 14 (Directory.Build.props), which is what keeps every other project on net10.0's language. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <LangVersion>15</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Read the implicit usings of the Pragmatic projects referenced, as an application gets them from the packages. -->
    <PragmaticInRepoImplicitUsings>true</PragmaticInRepoImplicitUsings>
    <!-- [LoggerMessage] is generated by Pragmatic, as it is for an application that installs the package. -->
    <PragmaticLogCallSites>true</PragmaticLogCallSites>

    <!-- The example is read as much as it is run: the generated code is written to obj/ so the README
         can point at it and count it. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
</Project>
