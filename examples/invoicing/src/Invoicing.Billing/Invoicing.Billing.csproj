<Project Sdk="Microsoft.NET.Sdk">

  <!-- Billing: the documents. It references Registry — one way, and never the reverse — to read the
       contract Registry publishes; it never touches Registry's entities. -->

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Invoicing.Registry\Invoicing.Registry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Validation\src\Pragmatic.Validation\Pragmatic.Validation.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Mapping\src\Pragmatic.Mapping\Pragmatic.Mapping.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Actions\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Endpoints\src\Pragmatic.Endpoints\Pragmatic.Endpoints.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Endpoints\src\Pragmatic.Endpoints.AspNetCore\Pragmatic.Endpoints.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence\Pragmatic.Persistence.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence.EFCore\Pragmatic.Persistence.EFCore.csproj" />
    <!-- The moves each module announces: the invoice's three, the company's two. Declared on the
         state machine and on the domain method, raised by the generator, recorded by a handler. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Events\src\Pragmatic.Events\Pragmatic.Events.csproj" />
    <!-- The invoice as a document: templates/invoice.pdxdoc, resolved by IPdxTemplates (Markup) in the
         customer's language, rendered to PDF. The renderer carries a native library and copies it to the
         output on Windows, Linux and macOS, so a ProjectReference needs nothing extra. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Documents\src\Pragmatic.Documents.Model\Pragmatic.Documents.Model.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Documents\src\Pragmatic.Documents.Markup\Pragmatic.Documents.Markup.csproj" />
    <ProjectReference Include="..\..\..\..\Pragmatic.Documents\src\Pragmatic.Documents.Pdf\Pragmatic.Documents.Pdf.csproj" />
    <!-- Where the rendered document is kept. The implementation is the host's choice. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Storage\src\Pragmatic.Storage\Pragmatic.Storage.csproj" />
    <!-- Money and CurrencyCode: an amount carries its currency, and both columns stay queryable. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Internationalization\src\Pragmatic.Internationalization\Pragmatic.Internationalization.csproj" />
    <!-- The change log of who drafted, issued or voided an invoice. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Audit\src\Pragmatic.Audit\Pragmatic.Audit.csproj" />
    <!-- Every entity of this module is ITenantEntity. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.MultiTenancy\src\Pragmatic.MultiTenancy\Pragmatic.MultiTenancy.csproj" />
    <!-- Same reason as in Registry: the generated endpoint gate reads the caller's roles through it. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Identity\src\Pragmatic.Identity.AspNetCore\Pragmatic.Identity.AspNetCore.csproj" />
    <!-- The nightly sweep that chases the overdue invoices: [RecurringJob] and IJob live here. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Jobs\src\Pragmatic.Jobs\Pragmatic.Jobs.csproj" />
    <!-- This module declares [EnableJobPersistence] on its boundary, so the two tables' configurations
         have to be nameable from here: a declaration whose subject the project cannot name is what
         PRAG2508 refuses. The generated DbContext that applies them is the host's. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Jobs\src\Pragmatic.Jobs.EFCore\Pragmatic.Jobs.EFCore.csproj" />
    <!-- The reminder itself. The transport is the host's choice; this module only builds the message. -->
    <ProjectReference Include="..\..\..\..\Pragmatic.Email\src\Pragmatic.Email\Pragmatic.Email.csproj" />
  </ItemGroup>

  <!-- The module's messages, one file per language. The generator reads them at compile time into keys
       (T.Invoice.Document.Total) and refuses a key one language has and the other lacks (PRAG1802); the
       host reads them at run time, from the output folder, to answer in the language each answer is owed
       in. Both entries are needed: AdditionalFiles feeds the compiler, Content puts the file where the
       running application can read it. -->
  <ItemGroup>
    <AdditionalFiles Include="translations\*.json" />
    <!-- Into this module's own folder: see the same note in Invoicing.Registry.csproj. -->
    <Content Include="translations\*.json" Link="translations\billing\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The invoice and the reminder, inside this assembly: a second module's invoice.pdxdoc cannot
         replace them the way two copied files on one path would. -->
    <EmbeddedResource Include="templates\*.pdxdoc;templates\*.pdxemail" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator.Analyzers\Pragmatic.SourceGenerator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
