<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <!-- As in Pragmatic.Configuration.Redis.Tests: ConfigureAwait is about library code resuming on a
         captured context, and a test has none worth avoiding. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Caching.Redis\Pragmatic.Caching.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
