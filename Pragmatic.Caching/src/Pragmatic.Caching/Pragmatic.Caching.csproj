<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source-generated caching with typed keys, automatic invalidation, and HybridCache integration. Zero magic strings.</Description>
    <PackageTags>caching;source-generator;hybridcache;redis;typed-keys</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Ensure\src\Pragmatic.Ensure\Pragmatic.Ensure.csproj" />
  </ItemGroup>

  <!-- Include source generator as analyzer -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- HybridCache (includes DI and Options transitively) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

</Project>
