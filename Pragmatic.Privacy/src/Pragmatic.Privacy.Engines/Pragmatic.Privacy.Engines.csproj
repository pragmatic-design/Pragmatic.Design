<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The subject registry and the consent store of Pragmatic.Privacy on Pragmatic's Sql and documents engines, over a boundary's session, beside Pragmatic.Privacy.EFCore: identities stored encrypted, found through a keyed blind index, and erased by breaking the link.</Description>
    <PackageTags>pragmatic;privacy;gdpr;pseudonymisation;sql;documents;mongodb;cosmosdb</PackageTags>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- The stores' own chains (the lookups, the consents' reads) are translated by the generator here, into this assembly. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Pragmatic.Persistence.Sql.Generated;Pragmatic.Persistence.Documents.Generated</InterceptorsNamespaces>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- The contracts (ISubjectRegistry, IConsentStore, ConsentRecord) and the blind index. -->
    <ProjectReference Include="..\Pragmatic.Privacy\Pragmatic.Privacy.csproj" />
    <!-- ISecretEncryptor: the identities are stored encrypted. -->
    <ProjectReference Include="..\..\..\Pragmatic.Cryptography\src\Pragmatic.Cryptography\Pragmatic.Cryptography.csproj" />
    <!-- The engines' bridges: the sessions a boundary is registered with. Private, as in Pragmatic.Audit.Engines: an application brings the
         bridge of the engine it uses, and flowing both would make every application reference two engines (PRAG0743). -->
    <ProjectReference Include="..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence.Sql\Pragmatic.Persistence.Sql.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\Pragmatic.Persistence\src\Pragmatic.Persistence.Documents\Pragmatic.Persistence.Documents.csproj" PrivateAssets="all" />
    <!-- The registry's rows and documents are the engines' own types: the generator describes them in this assembly, which declares them. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
