<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
    <!-- RS1036/RS1026, and RS1038/RS1041 since Microsoft.CodeAnalysis.Analyzers 3.11: the stand-in analyzer used by the suppressor
         tests is never shipped and never loaded by a compiler; the tests run it in process, beside Workspaces, on net10.0. -->
    <NoWarn>$(NoWarn);CA2007;RS1036;RS1026;RS1038;RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.SourceGenerator.Analyzers\Pragmatic.SourceGenerator.Analyzers.csproj" />
    <!-- The DiagnosticSuppressors ship inside the unified generator assembly. -->
    <ProjectReference Include="..\..\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" />
  </ItemGroup>

</Project>
