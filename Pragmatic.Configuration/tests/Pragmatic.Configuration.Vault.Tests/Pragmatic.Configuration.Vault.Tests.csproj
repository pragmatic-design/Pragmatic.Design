<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One target: a container suite runs on net10.0 only, and the hermetic suites run on both (#931). -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <!-- CA2007 conflicts with xUnit1030 in test projects -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Configuration.Vault\Pragmatic.Configuration.Vault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
