<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CA2007 conflicts with xUnit1030 in test projects -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <!-- The generated registration calls OptionsBuilder.Bind (Microsoft.Extensions.Options.ConfigurationExtensions),
       which the hosts get from the shared framework: the tests that compile and run the generated code need it too.
       It also brings Microsoft.Extensions.DependencyInjection and Options.DataAnnotations, the latter needed by the
       in-memory compilation so the generator can resolve validation attributes. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Configuration\Pragmatic.Configuration.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj" />
  </ItemGroup>

</Project>
