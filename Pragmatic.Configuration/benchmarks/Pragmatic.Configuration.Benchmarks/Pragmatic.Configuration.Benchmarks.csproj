<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Suppress CA1822 for BenchmarkDotNet (requires instance methods) -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Configuration\Pragmatic.Configuration.csproj" />
    <!-- The generator runs on THIS compilation: it writes the typed binder and the options registration for
         the workload's [Configuration] class, the ones the rows read through. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The container a host builds: the rows resolve through it, scopes and all. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
