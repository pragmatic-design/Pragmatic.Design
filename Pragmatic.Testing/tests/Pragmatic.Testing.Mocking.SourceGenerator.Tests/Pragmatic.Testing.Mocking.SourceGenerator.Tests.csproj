<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <!-- Only the mock generator. Referencing both generators from one project is not possible: each
       links the shared SourceGen code, so EquatableArray<T> would exist twice (CS0433) — which is
       itself a reason the two belong in separate assemblies. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Testing.Mocking.SourceGenerator\Pragmatic.Testing.Mocking.SourceGenerator.csproj" />
    <!-- The tests compile the generated source against the real runtime, so the contract between
         template and MockProperty/MockMethod is verified rather than assumed. -->
    <ProjectReference Include="..\..\src\Pragmatic.Testing\Pragmatic.Testing.csproj" />
  </ItemGroup>

</Project>
