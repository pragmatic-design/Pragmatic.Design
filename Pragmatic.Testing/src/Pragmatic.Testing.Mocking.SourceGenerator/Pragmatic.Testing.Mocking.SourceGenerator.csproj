<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generates reflection-free mocks from [GenerateMock&lt;T&gt;]. Separate from the contract-test generator: referencing one used to bring the other, and a project that wanted mocks also got contract tests it had no fixture to run.</Description>
    <PackageTags>testing;mocks;source-generator;roslyn;codegen</PackageTags>
    <!-- RS2008: analyzer release tracking is not used anywhere in this repo (same call as every other
         generator here); the PRAG2350-2353 descriptors are the record. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Testing.Mocking.SourceGenerator.Tests" />
  </ItemGroup>

</Project>
