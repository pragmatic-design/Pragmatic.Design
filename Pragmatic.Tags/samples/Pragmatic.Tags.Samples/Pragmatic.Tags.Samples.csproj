<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Tags.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      Samples for the runtime surface of the package. The [HasTags] generator runs
      in a consuming project, not in a console app, so these samples exercise the
      hand-written runtime types: HasTagsAttribute, TagBase, EntityTagBase<TEntityId>,
      ITagPolicy<TEntityId>. For the generated side end to end, see the Showcase.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Tags\Pragmatic.Tags.csproj" />
  </ItemGroup>

</Project>
