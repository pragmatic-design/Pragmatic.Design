<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pragmatic.Tags</RootNamespace>
    <Description>Tag trait plugin for Pragmatic.Design: adds [HasTags] attribute for auto-generated M:N tag entities, actions, and endpoints via source generation.</Description>
    <PackageTags>pragmatic;tags;trait;source-generator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
  </ItemGroup>

</Project>
