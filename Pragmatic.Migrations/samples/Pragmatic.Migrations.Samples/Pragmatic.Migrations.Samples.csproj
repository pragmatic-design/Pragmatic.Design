<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
    <!-- CLI entry point + client generators (CliCommands / ClientGeneration scenarios). -->
    <ProjectReference Include="..\..\src\Pragmatic.Migrations.Cli\Pragmatic.Migrations.Cli.csproj" />
    <!-- ITenantStore / TenantInfo / TenantState (Pragmatic.MultiTenancy namespace) and
         IHostStatus / HostState (Pragmatic.ControlPlane namespace) are defined in
         Pragmatic.Abstractions; samples disable transitive project references, so it
         must be referenced directly for the TenantMigrationOrchestrator scenario. -->
    <ProjectReference Include="..\..\..\Pragmatic.Abstractions\src\Pragmatic.Abstractions\Pragmatic.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- ILogger&lt;T&gt; / NullLogger appear in MigrationRunner ctor params and the
         leader-election scenario. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
