<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Starts Testcontainers: scripts/check.mjs runs these one at a time (see docs/TESTING.md). -->
    <RequiresDocker>true</RequiresDocker>
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
    <ProjectReference Include="..\..\src\Pragmatic.Migrations.Cli\Pragmatic.Migrations.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One helper, two suites. It lives with the hermetic tests, which are most of its callers, and is
         linked here rather than copied: a second copy is a second thing to keep true. -->
    <Compile Include="..\Pragmatic.Migrations.Core.Tests\Provider\NonOwningConnection.cs"
             Link="Provider\NonOwningConnection.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>


  <ItemGroup>
    <!-- Generated mocks: the runtime, plus the generator that turns [GenerateMock<T>] into a class. -->
    <ProjectReference Include="..\..\..\Pragmatic.Testing\src\Pragmatic.Testing\Pragmatic.Testing.csproj" />
    <!-- The unified generator registers the connection factory for each driver referenced above.
         Without it MigrationDriverRegistry stays empty and no provider is configured. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\Pragmatic.Testing\src\Pragmatic.Testing.Mocking.SourceGenerator\Pragmatic.Testing.Mocking.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
