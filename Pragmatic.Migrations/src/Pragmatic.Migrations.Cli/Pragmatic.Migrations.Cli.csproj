<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Both releases (#925): the snapshot loads the host's assembly into this process, and a host built for net11.0 needs the 11 runtime
         to be loaded. Packed as a tool with both, the SDK runs the build its runtime supports. The two targets
         come from Directory.Build.props (#931). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pragmatic-migrate</ToolCommandName>
    <Description>Interactive CLI for Pragmatic.Migrations: schema diff, preview, apply with rich terminal UX.</Description>
    <PackageTags>migrations;cli;schema;diff;interactive</PackageTags>
    <!-- A console tool on the web SDK for its shared framework: it serves no files. With static web
         assets on, the .NET 11 SDK gives it a Blazor hot-reload module in Debug, and every host that
         references it to run the schema snapshot (LocalCli.targets) fails on a module with no endpoint. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Configuration.Json and EnvironmentVariables are provided by the ASP.NET Core shared framework -->
  </ItemGroup>

  <!-- The name a property carries on the wire, the same file the generators compile: the TypeScript client
       must read and send what the server writes (#146). -->
  <ItemGroup>
    <Compile Include="$(SharedSourceGenPath)JsonWireNames.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
