<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pragmatic-migrate</ToolCommandName>
    <Description>Interactive CLI for Pragmatic.Migrations: schema diff, preview, apply with rich terminal UX.</Description>
    <PackageTags>migrations;cli;schema;diff;interactive</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.Migrations\Pragmatic.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Configuration.Json and EnvironmentVariables are provided by the ASP.NET Core shared framework -->
  </ItemGroup>

</Project>
