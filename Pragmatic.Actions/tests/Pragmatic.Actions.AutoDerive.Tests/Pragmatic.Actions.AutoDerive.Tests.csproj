<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Pragmatic.Actions.AutoDerive.Tests</RootNamespace>
    <!-- Auto-derivation is off by default and is an ASSEMBLY-WIDE switch, so it cannot be turned on in
         Pragmatic.Actions.Tests without changing what every action there derives. This project exists to
         hold the one shape that needs it on: the permission the generator derives reaching the filter
         that enforces it. -->
    <PragmaticAutoDerivePermissions>true</PragmaticAutoDerivePermissions>
    <!-- The generator reads it as a build property, so it has to be visible to the compiler too. -->
    <ExcludeSharedTesting>true</ExcludeSharedTesting>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="PragmaticAutoDerivePermissions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Actions\Pragmatic.Actions.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Result\src\Pragmatic.Result\Pragmatic.Result.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.Composition\src\Pragmatic.Composition\Pragmatic.Composition.csproj" />
    <!-- The generator runs on THIS compilation: the registry under test is the one it emits here. -->
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
