<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- [LoggerMessage] is Pragmatic's, as it is for an application that installs the generator's package. -->
    <PragmaticLogCallSites>true</PragmaticLogCallSites>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pragmatic.Logging\Pragmatic.Logging.csproj" />
    <ProjectReference Include="..\..\..\Pragmatic.SourceGenerator\src\Pragmatic.SourceGenerator\Pragmatic.SourceGenerator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The ASP.NET Core shared framework provides DI + Logging, plus the ASP.NET Core
       types used by BootstrapLogger and CorrelationIdProvider (DefaultHttpContext). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
