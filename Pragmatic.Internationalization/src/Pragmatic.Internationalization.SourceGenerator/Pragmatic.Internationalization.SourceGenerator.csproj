<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Source generator for Pragmatic.Internationalization - generates ISO country, currency, and language codes from embedded JSON resources.</Description>
    <PackageTags>source-generator;i18n;currency;iso4217;country;language</PackageTags>
    <!-- RS2008: Release tracking not required for diagnostics in this generator -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!-- Expose internals to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pragmatic.Internationalization.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Text.Json for JSON parsing in netstandard2.0 -->
    <PackageReference Include="System.Text.Json" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\currencies.json" LogicalName="currencies.json" />
    <EmbeddedResource Include="Resources\languages.json" LogicalName="languages.json" />
    <EmbeddedResource Include="Resources\countries.json" LogicalName="countries.json" />
  </ItemGroup>

</Project>
