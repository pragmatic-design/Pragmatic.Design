<Project>

  <!--
    The namespaces a module writes against with Pragmatic.Abstractions, added to the SDK's ImplicitUsings in a
    project that references this package. <PragmaticImplicitUsings>false</PragmaticImplicitUsings> in the
    project switches off the imports of every Pragmatic package.
  -->
  <ItemGroup Condition="('$(ImplicitUsings)' == 'enable' or '$(ImplicitUsings)' == 'true') and '$(PragmaticImplicitUsings)' != 'false'">
    <Using Include="Pragmatic.Authorization" />
    <!--
      [Service], [Module], [Include] and Lifetime. The enum is deliberately not called
      ServiceLifetime: the Web SDK imports that name from Microsoft.Extensions.DependencyInjection, and
      importing this namespace would make every mention of it CS0104.
    -->
    <Using Include="Pragmatic.Composition.Attributes" />
    <Using Include="Pragmatic.Composition.Database" />
    <Using Include="Pragmatic.Composition.Enums" />
    <Using Include="Pragmatic.Configuration" />
    <Using Include="Pragmatic.Events" />
    <Using Include="Pragmatic.FeatureFlags" />
    <Using Include="Pragmatic.Identity" />
    <Using Include="Pragmatic.MultiTenancy" />
    <Using Include="Pragmatic.Persistence.Entity" />
    <Using Include="Pragmatic.Persistence.Repository" />
    <Using Include="Pragmatic.Result" />
    <Using Include="Pragmatic.Specification" />
    <Using Include="Pragmatic.Temporal.Clock" />
  </ItemGroup>

</Project>
